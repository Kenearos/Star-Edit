# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Generierte Missionen / WAVs im Karten-Verzeichnis (Basis-Karte wird behalten,
# siehe Negation unten).
data/maps/*
!data/maps/base-map.scx
!data/maps/.gitkeep
# Template-Ordner: Struktur + README einchecken, die Template-Maps selbst aber nicht
# (koennen gross / lizenzbehaftet sein).
!data/maps/templates/
data/maps/templates/*
!data/maps/templates/README.md

# graphify: Build-Cache und generierte Artefakte (jederzeit neu baubar)
graphify-out/
.planning/graphs/
.planning/HANDOFF.json
